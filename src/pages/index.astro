---
import { getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Default from '../layouts/Default.astro';
import { site } from '../config';
import { pillarIcons } from '../data/pillar-icons';
import heroPhoto from '../assets/images/gallery/photo-14.png';
import ctaPhoto from '../assets/images/gallery/photo-07.png';

interface Pillar {
  num: string;
  title: string;
  card_title?: string;
  summary: string;
  body: string;
}

interface HomeFrontmatter {
  title: string;
  description?: string;
  eyebrow: string;
  hero_heading_top: string;
  hero_heading_accent: string;
  hero_heading_end: string;
  hero_lead: string;
  hero_cta_donate: string;
  hero_cta_involved: string;
  hero_photo_alt: string;
  hero_caption: string;
  pillars_heading: string;
  quote_eyebrow: string;
  quote: string;
  video_heading: string;
  gallery_heading: string;
  gallery_intro: string;
  events_cta: { eyebrow: string; title: string; body: string; cta: string };
  social_heading: string;
  social_intro: string;
}

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing content entry: pages/home');
const frontmatter = entry.data as HomeFrontmatter;

// The homepage pillar cards are the short form of the same five pillars the
// About page renders in full — single source of truth in content/about.md.
const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) throw new Error('Missing content entry: pages/about');
const pillars = (aboutEntry.data.pillars ?? []) as Pillar[];

const base = import.meta.env.BASE_URL;

const galleryImageModules = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/gallery/*.png', { eager: true })
).map(m => m.default);
const galleryImages = await Promise.all(
  galleryImageModules.map(async (thumb) => ({
    thumb,
    full: await getImage({ src: thumb, format: 'webp', width: 1000 }),
  }))
);
---
<Default title={frontmatter.title} description={frontmatter.description} lightbox={true}>

<!-- hero -->
<section data-r="g-hero" class="container container-pad container-1180">
  <div>
    <div class="eyebrow">{frontmatter.eyebrow}</div>
    <h2 data-r="t-hero">{frontmatter.hero_heading_top}<br><span class="text-accent">{frontmatter.hero_heading_accent}</span> {frontmatter.hero_heading_end}</h2>
    <p class="hero-lead">{frontmatter.hero_lead}</p>
    <div class="btn-group">
      <a href={site.donate_url} target="_blank" rel="noopener" class="btn btn-red">{frontmatter.hero_cta_donate}</a>
      <a href={`${base}get-involved/`} class="btn btn-ghost-navy">{frontmatter.hero_cta_involved} &rsaquo;</a>
    </div>
  </div>
  <div class="img-frame">
    <div class="hero-frame-inner">
      <Image src={heroPhoto} alt={frontmatter.hero_photo_alt} width={700} format="webp" loading="eager" />
    </div>
    <div class="hero-caption">{frontmatter.hero_caption}</div>
  </div>
</section>

<!-- pillars -->
<section class="container container-pad container-1180 pillars-section">
  <div class="section-divider"><h3>{frontmatter.pillars_heading}</h3></div>
  <div data-r="g5">
    {pillars.map(pillar => (
      <div data-r="g4cell">
        <svg viewBox="0 0 24 24" fill="none" stroke="#b08534" stroke-width="1.4" set:html={pillarIcons[pillar.num] ?? ''} />
        <div>{pillar.num}</div>
        <h4>{pillar.card_title ?? pillar.title}</h4>
        <p>{pillar.summary}</p>
      </div>
    ))}
  </div>
</section>

<!-- quote band -->
<section class="quote-band">
  <div class="container container-780">
    <span class="eyebrow">{frontmatter.quote_eyebrow}</span>
    <p data-r="t-quote">&ldquo;{frontmatter.quote}&rdquo;</p>
  </div>
</section>

<!-- video -->
<section class="container container-pad container-900 video-section">
  <div class="section-divider section-divider-tight"><h3>{frontmatter.video_heading}</h3></div>
  <div class="img-frame">
    <div class="video-frame">
      <iframe width="100%" height="100%" src={site.youtube_embed_url} title="Benicians Adopting Benicia" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
  </div>
</section>

<!-- gallery -->
<section class="container container-pad container-1180 gallery-section">
  <div class="gallery-heading-wrap">
    <h3 class="gallery-heading">{frontmatter.gallery_heading}</h3>
    <p class="gallery-intro">{frontmatter.gallery_intro}</p>
  </div>
  <div data-r="g4 g-gallery">
    {galleryImages.map(({ thumb, full }) => (
      <a href={full.src} class="glightbox gallery-item" data-gallery="community" data-description="Benicians Adopting Benicia">
        <Image src={thumb} alt="Benicians Adopting Benicia community photo" width={500} format="webp" />
      </a>
    ))}
  </div>
</section>

<!-- events CTA -->
<section class="events-cta-band container-pad">
  <div data-r="g-split" class="container container-1180">
    <div data-r="cta-l">
      <div class="eyebrow">{frontmatter.events_cta.eyebrow}</div>
      <h3 class="events-cta-heading">{frontmatter.events_cta.title}</h3>
      <p class="events-cta-copy">{frontmatter.events_cta.body}</p>
      <a href={`${base}events/`} class="btn btn-navy">{frontmatter.events_cta.cta}</a>
    </div>
    <div class="events-cta-img-wrap">
      <Image data-r="cta-img" src={ctaPhoto} alt="" width={700} format="webp" />
    </div>
  </div>
</section>

<!-- social -->
<section class="container container-pad container-900 social-section">
  <h3 class="social-heading">{frontmatter.social_heading}</h3>
  <p class="social-intro">{frontmatter.social_intro}</p>
  <div class="social-links">
    <a href={site.instagram_url} target="_blank" rel="noopener" class="link-quiet">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      <span>Instagram</span>
    </a>
    <a href={site.facebook_url} target="_blank" rel="noopener" class="link-quiet">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      <span>Facebook</span>
    </a>
    <a href={site.youtube_url} target="_blank" rel="noopener" class="link-quiet">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      <span>YouTube</span>
    </a>
  </div>
</section>

</Default>
